# Normalize line endings to LF on commit, check out as-is
* text=auto eol=lf

# Explicitly declare text files
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf

# Binary files — never diff or modify
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
