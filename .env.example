# Copy this file to .env and fill in values before running docker-compose

# PostgreSQL
POSTGRES_DB=devolvefacill
POSTGRES_USER=devolvefacill
POSTGRES_PASSWORD=devolvefacill_secret_change_me

# RabbitMQ
RABBITMQ_DEFAULT_USER=devolvefacill
RABBITMQ_DEFAULT_PASS=rabbitmq_secret_change_me

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_change_me

# JWT
JWT_KEY=change_me_use_at_least_32_chars_secret_key_here_!

# VTEX (Phase 4 — leave empty to use Mock adapter)
VTEX_ACCOUNT_NAME=
VTEX_APP_KEY=
VTEX_APP_TOKEN=

# Correios (Phase 4 — leave empty to use Mock adapter)
CORREIOS_USERNAME=
CORREIOS_PASSWORD=
CORREIOS_CARTAO_POSTAGEM=

# SAP ERP (Phase 4 — leave empty to use Mock adapter)
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_FINANCE_EMAIL=guilherme.schneider@lamoda.com.br

# Email/SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=

# Providers (set to real names in production: Vtex, Correios, Sap)
COMMERCE_PROVIDER=Mock
CARRIER_PROVIDER=Mock
ERP_PROVIDER=Mock
STORAGE_PROVIDER=Mock

# Initial admin user (seeded on first startup if no admin users exist)
SEED_ADMIN_EMAIL=admin@lamoda.com.br
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=Lamoda@2024!
SEED_ADMIN_ROLE=Supervisor
